# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Every value here is read via pydantic-settings (see src/etl_migrator/config.py)
# with the ETLM_ prefix. There are no hardcoded secrets anywhere in the source.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# scripted | anthropic | openai
#   scripted -> deterministic fixtures from fixtures/llm, no network, no key.
#               Used by CI and by `make demo`.
ETLM_LLM_PROVIDER=scripted
ETLM_LLM_MODEL=claude-sonnet-4-5
ETLM_LLM_API_KEY=
ETLM_LLM_BASE_URL=
ETLM_LLM_TEMPERATURE=0.0
ETLM_LLM_MAX_TOOL_ITERATIONS=6
# Directory of recorded responses used when ETLM_LLM_PROVIDER=scripted
ETLM_LLM_FIXTURE_DIR=fixtures/llm

# --- Workspace --------------------------------------------------------------
ETLM_WORKSPACE_DIR=.workspace

# --- Temporal (phase 2) -----------------------------------------------------
ETLM_TEMPORAL_HOST=localhost:7233
ETLM_TEMPORAL_NAMESPACE=default
ETLM_TEMPORAL_TASK_QUEUE=etl-migration
# Leave empty for one worker serving everything, which is right on a laptop.
# Set it (see k8s/) and the activities that execute untrusted generated code are
# served by a separate worker — the one deployed with no internet egress.
ETLM_TEMPORAL_EXECUTION_TASK_QUEUE=

# --- Storage (phase 3) ------------------------------------------------------
ETLM_POSTGRES_URL=postgresql://etlm:etlm@localhost:5432/etlm
ETLM_MINIO_ENDPOINT=http://localhost:9000
ETLM_MINIO_ACCESS_KEY=
ETLM_MINIO_SECRET_KEY=
ETLM_MINIO_BUCKET=etl-migrations

# --- GitHub -----------------------------------------------------------------
# Both are needed to open pull requests. Leave them blank and the delivery stage
# reports that it was skipped rather than failing the migration — a local run
# without GitHub is an ordinary thing to do.
# The token needs `contents: write` and `pull-requests: write` on the target repo.
ETLM_GITHUB_TOKEN=
ETLM_GITHUB_REPOSITORY=owner/repo

# --- Kubernetes (phase 8) ---------------------------------------------------
ETLM_KUBERNETES_NAMESPACE=etl-migration

# --- Observability ----------------------------------------------------------
ETLM_LOG_LEVEL=INFO
ETLM_LOG_FORMAT=console
# Where the worker serves /metrics and /healthz. Scraped by Prometheus; the
# Kubernetes NetworkPolicy opens exactly this port and nothing else inbound.
ETLM_METRICS_PORT=9464
